# Canonical origin for metadata, robots, and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false for local and preview deployments. Set true only after written
# publication approval and production-domain verification.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Public contact configuration. Leave the number empty until the destination
# and prefilled wording have been approved for production use.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello, I would like to know more about Glitz Pride.
