# Server-only key from Google AI Studio. Never expose this with a NEXT_PUBLIC_ prefix.
GOOGLE_GENERATIVE_AI_API_KEY=

# Comma-separated production origins permitted to call same-origin APIs.
APP_ALLOWED_ORIGINS=https://glitz-pride-community.vercel.app

# Random server-only value used to pseudonymize rate-limit client keys.
API_RATE_LIMIT_SALT=

# Optional owner-approved model rates used only for approximate cost metrics.
# Leave blank until the selected production provider publishes confirmed rates.
AI_INPUT_COST_USD_PER_MILLION_TOKENS=
AI_OUTPUT_COST_USD_PER_MILLION_TOKENS=

# Local knowledge administration. Use distinct editor and reviewer identities.
KNOWLEDGE_ADMIN_ACTOR=
KNOWLEDGE_ADMIN_ROLE=
KNOWLEDGE_ADMIN_CREDENTIAL=
KNOWLEDGE_EDITOR_CREDENTIAL=
KNOWLEDGE_REVIEWER_CREDENTIAL=
