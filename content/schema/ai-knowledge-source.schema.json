{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glitz-pride-community.vercel.app/schemas/ai-knowledge-source.schema.json",
  "title": "Glitz Pride AI knowledge-source register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registerId",
    "projectId",
    "asOfDate",
    "governance",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "registerId": {
      "type": "string",
      "const": "glitz-pride-ai-knowledge-sources"
    },
    "projectId": { "type": "string", "const": "glitz-pride" },
    "asOfDate": { "type": "string", "format": "date" },
    "governance": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "required": [
        "retrievalRule",
        "pendingRule",
        "conflictRule",
        "expiryRule",
        "derivedRule"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "authorityTier",
          "decision",
          "owner",
          "steward",
          "location",
          "format",
          "effectiveDate",
          "lastVerifiedOn",
          "reviewCadenceDays",
          "allowedUses",
          "prohibitedUses",
          "approvalEvidence",
          "reviewTrigger",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^KS-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "authorityTier": { "type": "string", "minLength": 1 },
          "decision": {
            "enum": [
              "approved",
              "approved-with-qualifications",
              "pending",
              "excluded",
              "superseded"
            ]
          },
          "owner": { "type": "string", "minLength": 1 },
          "steward": { "type": "string", "const": "AKHIL" },
          "location": { "type": ["string", "null"] },
          "format": { "type": "string", "minLength": 1 },
          "effectiveDate": { "type": ["string", "null"], "format": "date" },
          "lastVerifiedOn": { "type": ["string", "null"], "format": "date" },
          "reviewCadenceDays": { "type": ["integer", "null"], "minimum": 1 },
          "allowedUses": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "prohibitedUses": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "approvalEvidence": { "type": ["string", "null"] },
          "reviewTrigger": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
